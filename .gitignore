# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
htmlcov/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# ---------------------------------------------------------------------------
# C / C++ build artifacts
# ---------------------------------------------------------------------------
*.o
*.d
*.a
*.lo
*.la

# ---------------------------------------------------------------------------
# Editor / IDE / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs / temp
# ---------------------------------------------------------------------------
*.log
*.tmp

# ---------------------------------------------------------------------------
# HartBreaker runtime directories (defaults from scripts/env.sh).
# Override via HARTATTACK_DATADIR / HARTATTACK_BUGDIR / DESIGN_DIR / TOOLDIR
# to relocate them outside the repo.
# ---------------------------------------------------------------------------
run-data/
bug_backup/
design-sources/
.tools/

# ---------------------------------------------------------------------------
# Simulator binaries and their cfg.json -- both are produced by the docker
# build scripts in scripts/.
# ---------------------------------------------------------------------------
/simulators/*/
# Keep the reproducible four-hart Rocket design metadata, not its simulator binary.
!/simulators/quadrocket/
/simulators/quadrocket/*
!/simulators/quadrocket/cfg.json

# ---------------------------------------------------------------------------
# Paper output (regenerated by artifact_reproduction/figure_*.sh)
# ---------------------------------------------------------------------------
figures/

# ---------------------------------------------------------------------------
# Benchmark data collected by artifact_reproduction/collect_data.sh.
# ---------------------------------------------------------------------------
artifact_reproduction/data/benchmark/

# ---------------------------------------------------------------------------
# RISCV-DV pre-built corpus tarball (~14 GB) -- distribute via Zenodo, not git.
# README.md and metadata.json in this directory stay tracked.
# ---------------------------------------------------------------------------
artifact_reproduction/data/riscvdv_corpus/riscvdv-out.tar.gz

# ---------------------------------------------------------------------------
# Coverage comparison build + run outputs
# ---------------------------------------------------------------------------
# milesan-yosys and riscv-dv live inside the covcollect Docker image (see
# docker/Dockerfile.covcollect); ignore any stray host clone.
coverage_comparaison/tools/
coverage_comparaison/out/
coverage_comparaison/cov_data/
coverage_comparaison/cov_data.bak/
coverage_comparaison/corpus/hartattack/
coverage_comparaison/corpus/riscvdv/
coverage_comparaison/auto_cover_toggled.out
coverage_comparaison/cov_names
