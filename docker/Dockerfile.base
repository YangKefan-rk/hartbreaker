

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# RISCV binary locationRISCV
ENV RISCV="/opt/riscv"
ENV PATH="${PATH}:${RISCV}/bin"
ENV PATH="${PATH}:/opt/bin"

ARG USER_ID
ARG GROUP_ID
ARG HARTATTACK_CORES

# Install some dependencies
RUN apt-get update && apt-get install -y \
apt-utils \
curl \
wget \
gnupg \
build-essential \
apt-transport-https \
git \
perl \
python3 \
python3-pip \
python3-dev \
python3-venv \
make \
autoconf \
g++ \
flex \
bison \
ccache \
libgoogle-perftools-dev \
numactl \
perl-doc \
libfl2 \
libfl-dev \
zlib1g \
zlib1g-dev \
automake \
autotools-dev \
libmpc-dev \
libmpfr-dev \
libgmp-dev \
gawk \
texinfo \
gperf \
libtool \
patchutils \
bc \
gtkwave \
clang \
tcl-dev \
libreadline-dev \
jq \
libexpat-dev \
device-tree-compiler \
vim \
software-properties-common \
default-jdk \
default-jre \
gengetopt \
patch \
diffstat \
texi2html \
subversion \
chrpath \
libgtk-3-dev \
gettext \
rsync \
libguestfs-tools \
expat \
libexpat1-dev \
libusb-dev \
libncurses5-dev \
cmake \
help2man \
ninja-build \
zsh \
zip \
unzip \
sudo

RUN groupadd --gid $GROUP_ID attacker \
&& useradd --uid $USER_ID --gid $GROUP_ID --create-home attacker \
&& echo 'attacker ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Get RISCV toolchain
RUN wget -O /tmp/riscv.tar.xz https://github.com/riscv-collab/riscv-gnu-toolchain/releases/download/2025.01.20/riscv64-elf-ubuntu-22.04-gcc-nightly-2025.01.20-nightly.tar.xz \
&& tar -xf /tmp/riscv.tar.xz -C /opt \
&& rm /tmp/riscv.tar.xz

# Install spike
RUN git clone https://github.com/riscv-software-src/riscv-isa-sim.git \
&& cd riscv-isa-sim \
&& mkdir build \
&& cd build \
&& ../configure --prefix=${RISCV} \
&& make -j ${HARTATTACK_CORES} \
&& make install

# Install Python dependencies and set PATH
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip3 install tqdm numpy matplotlib filelock psutil sysv_ipc pyelftools rich z3-solver
RUN chmod -R 777 /opt/venv

# Remove apt-cache to keep image low
RUN rm -rf /var/lib/apt/lists/*
